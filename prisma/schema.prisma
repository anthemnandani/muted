generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String            @id
  createdAt                DateTime          @default(now()) @map(name: "created_at")
  updatedAt                DateTime          @default(now()) @map(name: "updated_at")
  username                 String            @unique
  fullName                 String?
  image                    String?
  bio                      String?
  link                     String?
  email                    String            @unique
  verified                 Boolean?          @default(false)
  privacy                  Privacy           @default(PUBLIC)
  followers                User[]            @relation(name: "followers")
  following                User[]            @relation(name: "followers")
  posts                    Post[]
  likedPosts               Like[]
  isAdmin                  Boolean?          @default(false) @map(name: "is_admin")
  reposts                  Repost[]
  reports                  Report[]
  reportSubmissions        Report[]          @relation("ReportSubmissions")
  reportTargets            Report[]          @relation("ReportTargets")
  bookmarks                Bookmark[]
  mentions                 Mention[]
  hiddenPosts              HiddenPost[]
  mutedUsers               MutedUser[]       @relation("mutedBy")
  mutedByUsers             MutedUser[]       @relation("muted")
  senderNotifications      Notification[]    @relation("sender")
  receiverNotifications    Notification[]    @relation("receiver")
  collections              Collection[]
  blockedUsers             BlockedUser[]     @relation("blocking")
  blockedByUsers           BlockedUser[]     @relation("blocked")
  sentMessages             Message[]         @relation("SentMessages")
  sender                   Chat[]            @relation("Sender")
  receiver                 Chat[]            @relation("Receiver")
  chatDeletions            ChatDeletion[]
  reactions                MessageReaction[]
  messageDeletions         MessageDeletion[]
  mutedChats               MutedChat[]
  messageReportSubmissions MessageReport[]   @relation("MessageReportSubmissions")
  messageReportTargets     MessageReport[]   @relation("MessageReportTargets")

  @@unique([createdAt, id])
}

enum Privacy {
  PUBLIC
  PRIVATE
}

model Post {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  text            String?
  media           Json?
  likes           Like[]
  parentPostId    String?
  parentPost      Post?          @relation("rootPost", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies         Post[]         @relation("rootPost")
  notification    Notification[]
  reposts         Repost[]
  quoteId         String?
  privacy         PostPrivacy    @default(ANYONE)
  reports         Report[]
  bookmarks       Bookmark[]
  mentions        Mention[]
  hashtags        Hashtag[]      @relation("PostHashtags")
  repliesCount    Int            @default(0)
  path            String?
  hideLikes       Boolean        @default(false)
  turnOffComments Boolean        @default(false)
  hiddenBy        HiddenPost[]
  lastEditedAt    DateTime?
  linkPreviewUrl  String?
  linkPreview     LinkPreview?   @relation(fields: [linkPreviewUrl], references: [url])
  pinned          Boolean        @default(false)

  @@unique([createdAt, id])
  @@index([linkPreviewUrl])
  @@index([authorId])
  @@index([parentPostId])
  @@index([path])
}

model Mention {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  index     Int

  @@index([postId])
  @@index([userId])
}

model Like {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
  @@index([postId])
}

model Repost {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
}

model Bookmark {
  createdAt    DateTime   @default(now())
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([postId, userId, collectionId])
  @@index([userId])
  @@index([postId])
  @@index([collectionId])
}

enum CollectionPrivacy {
  PUBLIC
  PRIVATE
}

model Collection {
  id          String            @id @default(cuid())
  name        String
  description String?
  privacy     CollectionPrivacy @default(PUBLIC)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks   Bookmark[]
  isDefault   Boolean           @default(false)

  @@unique([name, userId])
  @@index([userId])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOWER
  MENTION
}

model Notification {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  read      Boolean          @default(false)
  type      NotificationType
  message   String

  senderUserId   String
  receiverUserId String?
  senderUser     User    @relation("sender", fields: [senderUserId], references: [id], onDelete: Cascade)
  receiverUser   User?   @relation("receiver", fields: [receiverUserId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id])

  @@index([receiverUserId])
  @@index([senderUserId])
  @@index([type])
}

enum PostPrivacy {
  FOLLOWERS
  FOLLOWED
  ANYONE
  MENTIONED
}

model Hashtag {
  id        String   @id @default(cuid())
  name      String   @unique
  posts     Post[]   @relation("PostHashtags")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model LinkPreview {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  description String?
  image       String?
  createdAt   DateTime @default(now())
  posts       Post[]

  @@index([url])
}

model HiddenPost {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
}

model MutedUser {
  createdAt     DateTime @default(now())
  mutedUser     User     @relation("muted", fields: [mutedUserId], references: [id], onDelete: Cascade)
  mutedUserId   String
  mutedByUser   User     @relation("mutedBy", fields: [mutedByUserId], references: [id], onDelete: Cascade)
  mutedByUserId String

  @@id([mutedUserId, mutedByUserId])
  @@index([mutedByUserId])
}

model BlockedUser {
  createdAt      DateTime @default(now())
  blockedUser    User     @relation("blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blockedUserId  String
  blockingUser   User     @relation("blocking", fields: [blockingUserId], references: [id], onDelete: Cascade)
  blockingUserId String

  @@id([blockedUserId, blockingUserId])
  @@index([blockingUserId])
}

model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  reporterId String
  reporter   User   @relation("ReportSubmissions", fields: [reporterId], references: [id], onDelete: Cascade)

  categoryId     String
  subCategoryId  String?
  detailId       String?
  reason         String
  additionalInfo String?
  targetUserId   String?
  targetUser     User?   @relation("ReportTargets", fields: [targetUserId], references: [id], onDelete: SetNull)

  status ReportStatus @default(PENDING)

  @@unique([reporterId, postId])
  @@unique([reporterId, userId])
  @@index([status])
  @@index([createdAt])
  @@index([categoryId])
  @@index([postId])
  @@index([userId])
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

model SearchQuery {
  id        String   @id @default(cuid())
  query     String   @unique
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([query])
  @@index([count])
}

model ChatDeletion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  chatId    String
  userId    String
  deletedAt DateTime @default(now())

  lastMessageId String?
  isActive      Boolean @default(true)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model MutedChat {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@index([isActive])
}

model Chat {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderId   String
  receiverId String
  sender     User   @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User   @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime?
  isActive      Boolean   @default(true)

  messageRequest       Boolean               @default(false)
  messageRequestStatus MessageRequestStatus?
  requestedById        String?

  messages      Message[]
  chatDeletions ChatDeletion[]
  mutedBy       MutedChat[]

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([lastMessageAt])
  @@index([messageRequest])
  @@index([messageRequestStatus])
}

enum MessageType {
  TEXT
  MEDIA
}

enum MessageStatus {
  SENT
  SEEN
  SENDING
  FAILED
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content String
  type    MessageType @default(TEXT)

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  status    MessageStatus     @default(SENT)
  reactions MessageReaction[]
  deletions MessageDeletion[]
  reports   MessageReport[]

  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emoji String

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageDeletion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

enum MessageReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

enum MessageReportCategory {
  NUDITY_SEXUAL
  SEXTORTION_INTIMATE_ABUSE
  REGULATED_GOODS
  HATE_HARASSMENT
  FRAUDS_SCAMS
  MINOR_SAFETY
  MISINFORMATION
  VIOLENCE_CRIMINAL
  SHOCKING_GRAPHIC
  SUICIDE_SELF_HARM
  EATING_DISORDER
  DANGEROUS_ACTIVITIES
  DECEPTIVE_SPAM
  PERSONAL_INFO
  DANGEROUS_GOODS
  INTELLECTUAL_PROPERTY
  ADVERTISEMENT_MISMATCH
  OTHER
}

model MessageReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("MessageReportSubmissions", fields: [reporterId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("MessageReportTargets", fields: [targetUserId], references: [id], onDelete: Cascade)

  category MessageReportCategory
  reason   String

  status     MessageReportStatus @default(PENDING)
  reviewedAt DateTime?

  @@unique([reporterId, messageId])
  @@index([messageId])
  @@index([reporterId])
  @@index([targetUserId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}
