generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

enum Privacy {
  PUBLIC
  PRIVATE
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                       String            @id
  createdAt                DateTime          @default(now()) @map(name: "created_at")
  updatedAt                DateTime          @default(now()) @map(name: "updated_at")
  username                 String            @unique
  fullName                 String?
  image                    String?
  bio                      String?
  link                     String?
  email                    String            @unique
  verified                 Boolean?          @default(false)
  privacy                  Privacy           @default(PUBLIC)
  deactivated              Boolean?          @default(false)
  deactivatedAt            DateTime?
  deletionOtp              String?
  deletionOtpExpiresAt     DateTime?
  role                     Role              @default(USER)
  status                   UserStatus        @default(ACTIVE)
  suspensionEndDate        DateTime?
  strikes                  Strike[]
  followers                Follow[]          @relation("Followers")
  following                Follow[]          @relation("Following")
  posts                    Post[]
  likedPosts               Like[]
  isAdmin                  Boolean?          @default(false) @map(name: "is_admin")
  reposts                  Repost[]
  reports                  Report[]
  reportSubmissions        Report[]          @relation("ReportSubmissions")
  reportTargets            Report[]          @relation("ReportTargets")
  bookmarks                Bookmark[]
  mentions                 Mention[]
  hiddenPosts              HiddenPost[]
  mutedUsers               MutedUser[]       @relation("mutedBy")
  mutedByUsers             MutedUser[]       @relation("muted")
  senderNotifications      Notification[]    @relation("sender")
  receiverNotifications    Notification[]    @relation("receiver")
  collections              Collection[]
  blockedUsers             BlockedUser[]     @relation("blocking")
  blockedByUsers           BlockedUser[]     @relation("blocked")
  sentMessages             Message[]         @relation("SentMessages")
  sender                   Chat[]            @relation("Sender")
  receiver                 Chat[]            @relation("Receiver")
  chatDeletions            ChatDeletion[]
  threads                  Thread[]
  reactions                MessageReaction[]
  messageDeletions         MessageDeletion[]
  mutedChats               MutedChat[]
  filteredKeywords         FilteredKeyword[]
  appeals                  Appeal[]
  suspensions              Suspension[]
  messageReportSubmissions MessageReport[]   @relation("MessageReportSubmissions")
  messageReportTargets     MessageReport[]   @relation("MessageReportTargets")
  sentFollowRequests       FollowRequest[]   @relation("SentFollowRequests")
  receivedFollowRequests   FollowRequest[]   @relation("ReceivedFollowRequests")

  @@unique([createdAt, id])
}

enum PostPrivacy {
  FOLLOWERS
  FOLLOWED
  ANYONE
  MENTIONED
}

enum PostStatus {
  VISIBLE
  HIDDEN
}

model Post {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  text            String?
  // threadText      String?
  media           Json?
  // media        Media[]
  likes           Like[]
  parentPostId    String?
  parentPost      Post?          @relation("rootPost", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies         Post[]         @relation("rootPost")
  notifications   Notification[]
  reposts         Repost[]
  quoteId         String?
  privacy         PostPrivacy    @default(ANYONE)
  reports         Report[]
  bookmarks       Bookmark[]
  mentions        Mention[]
  hashtags        Hashtag[]      @relation("PostHashtags")
  repliesCount    Int            @default(0)
  path            String?
  hideLikes       Boolean        @default(false)
  turnOffComments Boolean        @default(false)
  status          PostStatus     @default(HIDDEN)
  hiddenBy        HiddenPost[]
  lastEditedAt    DateTime?
  // linkPreviewUrl  String?
  // linkPreview     LinkPreview?   @relation(fields: [linkPreviewUrl], references: [url])
  pinned          Boolean        @default(false)
  Media           Media[]
  LinkPreview     LinkPreview?   @relation(fields: [linkPreviewId], references: [id])
  linkPreviewId   String?

  @@unique([createdAt, id])
  // @@index([linkPreviewUrl])
  @@index([authorId])
  @@index([parentPostId])
  @@index([path])
}

model Thread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  text String  @db.Text
  path String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  media Media[]

  parentId        String?
  parent          Thread?  @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Thread[] @relation("ThreadReplies")
  repliesCount    Int      @default(0)
  hideLikes       Boolean  @default(false)
  turnOffComments Boolean  @default(false)

  quoteId        String?
  quote          Thread?      @relation("ThreadQuotes", fields: [quoteId], references: [id], onDelete: SetNull)
  quotedBy       Thread[]     @relation("ThreadQuotes")
  linkPreviewUrl String?
  linkPreview    LinkPreview? @relation(fields: [linkPreviewUrl], references: [url])

  likes         Like[]
  reposts       Repost[]
  mentions      Mention[]
  bookmarks     Bookmark[]
  hashtags      Hashtag[]      @relation("ThreadHashtags")
  reports       Report[]
  notifications Notification[]
  hiddenBy      HiddenPost[]
  lastEditedAt  DateTime?

  privacy PostPrivacy @default(ANYONE)
  status  PostStatus  @default(VISIBLE)

  @@unique([createdAt, id])
  @@index([authorId])
  @@index([parentId])
  @@index([quoteId])
}

enum FileType {
  IMAGE
  VIDEO
}

enum EncodingStatus {
  PROCESSING
  ENCODED
  FAILED
}

model Media {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  fileUrl  String
  fileType FileType
  altText  String?

  width       Int
  height      Int
  aspectRatio String?

  videoId        String?
  playbackId     String?
  thumbnailUrl   String?
  videoToken     String?
  thumbnailToken String?
  encodingStatus EncodingStatus?

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([threadId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Mention {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  threadId  String?
  thread    Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  index     Int

  @@index([postId])
  @@index([threadId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, threadId])
  @@index([userId])
  @@index([postId])
  @@index([threadId])
}

model Repost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, threadId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, collectionId])
  @@unique([userId, threadId])
  @@index([userId])
  @@index([collectionId])
}

enum CollectionPrivacy {
  PUBLIC
  PRIVATE
}

model Collection {
  id          String            @id @default(cuid())
  name        String
  description String?
  privacy     CollectionPrivacy @default(PRIVATE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks   Bookmark[]
  isDefault   Boolean           @default(false)

  @@unique([name, userId])
  @@index([userId])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOWER
  MENTION
  FOLLOW_REQUEST
  WARNING
  SUSPENDED
  UNSUSPENDED
  ADMIN_PROMOTED
  ADMIN_DEMOTED
}

model Notification {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  read      Boolean          @default(false)
  type      NotificationType
  message   String

  senderUserId   String?
  receiverUserId String?
  senderUser     User?   @relation("sender", fields: [senderUserId], references: [id], onDelete: Cascade)
  receiverUser   User?   @relation("receiver", fields: [receiverUserId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id])

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([receiverUserId])
  @@index([senderUserId])
  @@index([type])
}

model Hashtag {
  id        String   @id @default(cuid())
  name      String   @unique
  posts     Post[]   @relation("PostHashtags")
  threads   Thread[] @relation("ThreadHashtags")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model LinkPreview {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  description String?
  image       String?
  createdAt   DateTime @default(now())
  // posts       Post[]
  threads     Thread[]
  Post        Post[]

  @@index([url])
}

model HiddenPost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  thread    Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, postId])
  @@unique([userId, threadId])
  @@index([userId])
}

model MutedUser {
  createdAt     DateTime @default(now())
  mutedUser     User     @relation("muted", fields: [mutedUserId], references: [id], onDelete: Cascade)
  mutedUserId   String
  mutedByUser   User     @relation("mutedBy", fields: [mutedByUserId], references: [id], onDelete: Cascade)
  mutedByUserId String

  @@id([mutedUserId, mutedByUserId])
  @@index([mutedByUserId])
}

model BlockedUser {
  createdAt      DateTime @default(now())
  blockedUser    User     @relation("blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blockedUserId  String
  blockingUser   User     @relation("blocking", fields: [blockingUserId], references: [id], onDelete: Cascade)
  blockingUserId String

  @@id([blockedUserId, blockingUserId])
  @@index([blockingUserId])
}

model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId   String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  reporterId String
  reporter   User   @relation("ReportSubmissions", fields: [reporterId], references: [id], onDelete: Cascade)

  categoryId     String
  subCategoryId  String?
  detailId       String?
  reason         String
  additionalInfo String?
  targetUserId   String?
  targetUser     User?   @relation("ReportTargets", fields: [targetUserId], references: [id], onDelete: SetNull)

  status ReportStatus @default(PENDING)

  @@unique([createdAt, id])
  @@unique([reporterId, postId])
  @@unique([reporterId, threadId])
  @@unique([reporterId, userId])
  @@index([status])
  @@index([createdAt])
  @@index([categoryId])
  @@index([postId])
  @@index([userId])
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

model SearchQuery {
  id        String   @id @default(cuid())
  query     String   @unique
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([query])
  @@index([count])
}

model ChatDeletion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  chatId    String
  userId    String
  deletedAt DateTime @default(now())

  lastMessageId String?
  isActive      Boolean @default(true)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
}

enum MessageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model MutedChat {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@index([isActive])
}

model Chat {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderId   String?
  receiverId String?
  sender     User?   @relation("Sender", fields: [senderId], references: [id], onDelete: SetNull)
  receiver   User?   @relation("Receiver", fields: [receiverId], references: [id], onDelete: SetNull)

  lastMessageAt DateTime?
  isActive      Boolean   @default(true)

  messageRequest       Boolean               @default(false)
  messageRequestStatus MessageRequestStatus?
  requestedById        String?

  messages      Message[]
  chatDeletions ChatDeletion[]
  mutedBy       MutedChat[]

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([lastMessageAt])
  @@index([messageRequest])
  @@index([messageRequestStatus])
}

enum MessageType {
  TEXT
  MEDIA
}

enum MessageStatus {
  SENT
  SEEN
  SENDING
  FAILED
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content String
  type    MessageType @default(TEXT)

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  senderId String? // Make optional
  sender   User?   @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  status    MessageStatus     @default(SENT)
  reactions MessageReaction[]
  deletions MessageDeletion[]
  reports   MessageReport[]

  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emoji String

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageDeletion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

enum MessageReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

enum MessageReportCategory {
  NUDITY_SEXUAL
  SEXTORTION_INTIMATE_ABUSE
  REGULATED_GOODS
  HATE_HARASSMENT
  FRAUDS_SCAMS
  MINOR_SAFETY
  MISINFORMATION
  VIOLENCE_CRIMINAL
  SHOCKING_GRAPHIC
  SUICIDE_SELF_HARM
  EATING_DISORDER
  DANGEROUS_ACTIVITIES
  DECEPTIVE_SPAM
  PERSONAL_INFO
  DANGEROUS_GOODS
  INTELLECTUAL_PROPERTY
  ADVERTISEMENT_MISMATCH
  OTHER
}

model MessageReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation("MessageReportSubmissions", fields: [reporterId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("MessageReportTargets", fields: [targetUserId], references: [id], onDelete: Cascade)

  category MessageReportCategory
  reason   String

  status     MessageReportStatus @default(PENDING)
  reviewedAt DateTime?

  @@unique([reporterId, messageId])
  @@index([messageId])
  @@index([reporterId])
  @@index([targetUserId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model FollowRequest {
  id          String              @id @default(cuid())
  requesterId String
  receiverId  String
  status      FollowRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  requester User @relation("SentFollowRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ReceivedFollowRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
}

enum FeedType {
  FOR_YOU
  FOLLOWING
  FRIENDS
}

model FilteredKeyword {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  keyword String
  feeds   FeedType[]

  @@unique([userId, keyword])
  @@index([userId])
}

model Strike {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason        String
  relatedPostId String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  suspension Suspension?

  @@index([userId])
}

enum AppealStatus {
  PENDING
  UPHELD
  OVERTURNED
}

model Appeal {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reason String       @db.Text
  status AppealStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  suspensionId String     @unique
  suspension   Suspension @relation(fields: [suspensionId], references: [id], onDelete: Cascade)

  @@unique([createdAt, id])
  @@index([userId])
  @@index([status])
}

enum SuspensionType {
  STRIKE_BASED
  MANUAL
}

model Suspension {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  endsAt    DateTime
  isActive  Boolean        @default(true)
  type      SuspensionType

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  appeal Appeal?

  strikeId String? @unique
  strike   Strike? @relation(fields: [strikeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isActive])
}
