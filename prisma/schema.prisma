generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String         @id
  createdAt             DateTime       @default(now()) @map(name: "created_at")
  updatedAt             DateTime       @default(now()) @map(name: "updated_at")
  username              String         @unique
  fullName              String?
  image                 String?
  bio                   String?
  link                  String?
  email                 String         @unique
  verified              Boolean?       @default(false)
  privacy               Privacy        @default(PUBLIC)
  followers             User[]         @relation(name: "followers")
  following             User[]         @relation(name: "followers")
  posts                 Post[]
  likedPosts            Like[]
  isAdmin               Boolean?       @default(false) @map(name: "is_admin")
  reposts               Repost[]
  reports               Report[]
  reportSubmissions     Report[]       @relation("ReportSubmissions")
  reportTargets         Report[]       @relation("ReportTargets")
  bookmarks             Bookmark[]
  mentions              Mention[]
  hiddenPosts           HiddenPost[]
  mutedUsers            MutedUser[]    @relation("mutedBy")
  mutedByUsers          MutedUser[]    @relation("muted")
  senderNotifications   Notification[] @relation("sender")
  receiverNotifications Notification[] @relation("receiver")
  collections           Collection[]
  blockedUsers          BlockedUser[]  @relation("blocking")
  blockedByUsers        BlockedUser[]  @relation("blocked")

  @@unique([createdAt, id])
}

enum Privacy {
  PUBLIC
  PRIVATE
}

model Post {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String
  text           String?
  media          Json?
  likes          Like[]
  parentPostId   String?
  parentPost     Post?          @relation("rootPost", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies        Post[]         @relation("rootPost")
  notification   Notification[]
  reposts        Repost[]
  quoteId        String?
  privacy        PostPrivacy    @default(ANYONE)
  reports        Report[]
  bookmarks      Bookmark[]
  mentions       Mention[]
  hashtags       Hashtag[]      @relation("PostHashtags")
  repliesCount   Int            @default(0)
  path           String?
  hideLikes      Boolean        @default(false)
  hiddenBy       HiddenPost[]
  lastEditedAt   DateTime?
  linkPreviewUrl String?
  linkPreview    LinkPreview?   @relation(fields: [linkPreviewUrl], references: [url])
  pinned         Boolean        @default(false)

  @@unique([createdAt, id])
  @@index([linkPreviewUrl])
  @@index([authorId])
  @@index([parentPostId])
  @@index([path])
}

model Mention {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  index     Int

  @@index([postId])
  @@index([userId])
}

model Like {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
  @@index([postId])
}

model Repost {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
}

model Bookmark {
  createdAt    DateTime   @default(now())
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([postId, userId, collectionId])
  @@index([userId])
  @@index([postId])
  @@index([collectionId])
}

enum CollectionPrivacy {
  PUBLIC
  PRIVATE
}

model Collection {
  id          String            @id @default(cuid())
  name        String
  description String?
  privacy     CollectionPrivacy @default(PUBLIC)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks   Bookmark[]
  isDefault   Boolean           @default(false)

  @@unique([name, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  read      Boolean          @default(false)
  type      NotificationType
  message   String
  isPublic  Boolean          @default(false)

  senderUserId   String
  receiverUserId String?
  senderUser     User    @relation("sender", fields: [senderUserId], references: [id], onDelete: Cascade)
  receiverUser   User?   @relation("receiver", fields: [receiverUserId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id])

  @@index([receiverUserId])
}

enum NotificationType {
  ADMIN
  LIKE
  REPLY
  FOLLOW
  REPOST
  QUOTE
  MENTION
  BOOKMARK
}

enum PostPrivacy {
  FOLLOWERS
  FOLLOWED
  ANYONE
  MENTIONED
}

model Hashtag {
  id        String   @id @default(cuid())
  name      String   @unique
  posts     Post[]   @relation("PostHashtags")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model LinkPreview {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  description String?
  image       String?
  createdAt   DateTime @default(now())
  posts       Post[]

  @@index([url])
}

model HiddenPost {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
}

model MutedUser {
  createdAt     DateTime @default(now())
  mutedUser     User     @relation("muted", fields: [mutedUserId], references: [id], onDelete: Cascade)
  mutedUserId   String
  mutedByUser   User     @relation("mutedBy", fields: [mutedByUserId], references: [id], onDelete: Cascade)
  mutedByUserId String

  @@id([mutedUserId, mutedByUserId])
  @@index([mutedByUserId])
}

model BlockedUser {
  createdAt      DateTime @default(now())
  blockedUser    User     @relation("blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  blockedUserId  String
  blockingUser   User     @relation("blocking", fields: [blockingUserId], references: [id], onDelete: Cascade)
  blockingUserId String

  @@id([blockedUserId, blockingUserId])
  @@index([blockingUserId])
}

model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  reporterId String
  reporter   User   @relation("ReportSubmissions", fields: [reporterId], references: [id], onDelete: Cascade)

  categoryId     String
  subCategoryId  String?
  detailId       String?
  reason         String
  additionalInfo String?
  targetUserId   String?
  targetUser     User?   @relation("ReportTargets", fields: [targetUserId], references: [id], onDelete: SetNull)

  status ReportStatus @default(PENDING)

  @@unique([reporterId, postId])
  @@unique([reporterId, userId])
  @@index([status])
  @@index([createdAt])
  @@index([categoryId])
  @@index([postId])
  @@index([userId])
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}
