generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String         @id
  createdAt             DateTime       @default(now()) @map(name: "created_at")
  updatedAt             DateTime       @default(now()) @map(name: "updated_at")
  username              String         @unique
  fullName              String?
  image                 String?
  bio                   String?
  link                  String?
  email                 String         @unique
  verified              Boolean?       @default(false)
  privacy               Privacy        @default(PUBLIC)
  followers             User[]         @relation(name: "followers")
  following             User[]         @relation(name: "followers")
  posts                 Post[]
  likedPosts            Like[]
  isAdmin               Boolean?       @default(false) @map(name: "is_admin")
  reposts               Repost[]
  reports               Report[]
  bookmarks             Bookmark[]
  mentions              Mention[]
  hiddenPosts           HiddenPost[]
  mutedUsers            MutedUser[]    @relation("mutedBy")
  mutedByUsers          MutedUser[]    @relation("muted")
  senderNotifications   Notification[] @relation("sender")
  receiverNotifications Notification[] @relation("receiver")

  @@unique([createdAt, id])
}

enum Privacy {
  PUBLIC
  PRIVATE
}

model Post {
  id             String         @id @default(cuid())
  createdAt      DateTime       @default(now())
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String
  text           String?
  media          Json?          @default("{}")
  likes          Like[]
  parentPostId   String?
  parentPost     Post?          @relation("rootPost", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies        Post[]         @relation("rootPost")
  notification   Notification[]
  reposts        Repost[]
  quoteId        String?
  privacy        PostPrivacy    @default(ANYONE)
  reports        Report[]
  bookmarks      Bookmark[]
  mentions       Mention[]
  hashtags       Hashtag[]      @relation("PostHashtags")
  repliesCount   Int            @default(0)
  path           String?
  hideLikes      Boolean        @default(false)
  hiddenBy       HiddenPost[]
  lastEditedAt   DateTime?
  linkPreviewUrl String?
  linkPreview    LinkPreview?   @relation(fields: [linkPreviewUrl], references: [url])

  @@unique([createdAt, id])
  @@index([linkPreviewUrl])
  @@index([authorId])
  @@index([parentPostId])
  @@index([path])
}

model Mention {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  index     Int

  @@index([postId])
  @@index([userId])
}

model Like {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
  @@index([postId])
}

model Repost {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
}

model Bookmark {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  read      Boolean          @default(false)
  type      NotificationType
  message   String
  isPublic  Boolean          @default(false)

  senderUserId   String
  receiverUserId String?
  senderUser     User    @relation("sender", fields: [senderUserId], references: [id], onDelete: Cascade)
  receiverUser   User?   @relation("receiver", fields: [receiverUserId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id])

  @@index([receiverUserId])
}

enum NotificationType {
  ADMIN
  LIKE
  REPLY
  FOLLOW
  REPOST
  QUOTE
  MENTION
  BOOKMARK
}

enum PostPrivacy {
  FOLLOWERS
  FOLLOWED
  ANYONE
  MENTIONED
}

model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  reason    String
  post      Post?    @relation(fields: [postId], references: [id])
  postId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Hashtag {
  id        String   @id @default(cuid())
  name      String   @unique
  posts     Post[]   @relation("PostHashtags")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model LinkPreview {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  description String?
  image       String?
  createdAt   DateTime @default(now())
  posts       Post[]

  @@index([url])
}

model HiddenPost {
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@id([postId, userId])
  @@index([userId])
}

model MutedUser {
  createdAt     DateTime @default(now())
  mutedUser     User     @relation("muted", fields: [mutedUserId], references: [id], onDelete: Cascade)
  mutedUserId   String
  mutedByUser   User     @relation("mutedBy", fields: [mutedByUserId], references: [id], onDelete: Cascade)
  mutedByUserId String

  @@id([mutedUserId, mutedByUserId])
  @@index([mutedByUserId])
}
