{
  "functions": {
    "app/api/**/*": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/deleteInactiveUsers",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/refresh-view-counts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 * * * *"
    }
  ]
}
